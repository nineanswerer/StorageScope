{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StorageScope",
  "version": "0.3.0-beta.2",
  "identifier": "com.storagescope.dev",
  "build": {
    "frontendDist": "../../../ui/dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "StorageScope · 磁盘空间管理",
        "width": 1200,
        "height": 800,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": [
      "../../../THIRD_PARTY_NOTICES.md",
      "../../../docs/USER_GUIDE.md",
      "../../../docs/SAFETY_AND_RECOVERY.md",
      "../../../docs/TROUBLESHOOTING.md"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
